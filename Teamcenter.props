<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ImportGroup Label="PropertySheets" />
  
  <PropertyGroup Label="UserMacros">
	<!-- USER VARIABLES -->
	<CLIENT_PREFIX>ITK_</CLIENT_PREFIX>
    <TC_VERSION Condition="'$(TC_VERSION)' == ''">2512</TC_VERSION>
	
	<!-- PATH RESOLUTION -->
    <TC_ROOT_DIR Condition="'$(TC_ROOT)' != ''">$(TC_ROOT)</TC_ROOT_DIR>
    <TC_ROOT_DIR Condition="'$(TC_ROOT)' == ''">$(DEV_DEPENDENCIES)\Teamcenter\TC$(TC_VERSION)</TC_ROOT_DIR>
  </PropertyGroup>

  <!-- PROJECT CONFIGURATION -->
  <PropertyGroup>
    <OutDir>$(SolutionDir)bin\$(Configuration)\$(TC_VERSION)\</OutDir>
    <IntDir>$(SolutionDir)obj\$(Configuration)\$(TC_VERSION)\$(ProjectName)\</IntDir>
	
	<UseClangFormat>true</UseClangFormat>
	<RunCodeAnalysis>false</RunCodeAnalysis>
	<EnableMicrosoftCodeAnalysis>false</EnableMicrosoftCodeAnalysis>
    <EnableClangTidyCodeAnalysis>true</EnableClangTidyCodeAnalysis>  
  </PropertyGroup>
  
  <!-- COMPILER SETTINGS -->
  <ItemDefinitionGroup>
    <ClCompile>
	  <MultiProcessorCompilation>true</MultiProcessorCompilation>
	  <LanguageStandard>stdcpp17</LanguageStandard>
	  
      <AdditionalIncludeDirectories>$(ProjectDir)\include;$(TC_ROOT_DIR)\include;$(TC_ROOT_DIR)\include_cpp;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>IPLIB=none;WIN32;CLIENT_PREFIX=$(CLIENT_PREFIX);TC_VERSION=$(TC_VERSION);%(PreprocessorDefinitions)</PreprocessorDefinitions>
      
	  <RuntimeLibrary Condition="'$(Configuration)' == 'Debug'">MultiThreadedDebugDLL</RuntimeLibrary>
	  <RuntimeLibrary Condition="'$(Configuration)' != 'Debug'">MultiThreadedDLL</RuntimeLibrary>
      
	  <WarningLevel>Level3</WarningLevel>
    </ClCompile>
    
    <Link>
      <AdditionalLibraryDirectories>$(TC_ROOT_DIR)\lib;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>$(TC_ROOT_DIR)\lib\*.lib;crypt32.lib;iphlpapi.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <IgnoreSpecificDefaultLibraries>LIBCMT</IgnoreSpecificDefaultLibraries>
	  
	  <GenerateDebugInformation Condition="'$(Configuration)' == 'Debug'">true</GenerateDebugInformation>
      <GenerateDebugInformation Condition="'$(Configuration)' != 'Debug'">false</GenerateDebugInformation>
    </Link>
  </ItemDefinitionGroup>

  <!-- ENVIRONMENT VALIDATION -->
  <Target Name="CheckEnvironment" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(TC_ROOT)' == '' And '$(DEV_DEPENDENCIES)' == ''" 
           Text="ERROR: Neither TC_ROOT nor DEV_DEPENDENCIES environment variables were found." />
    <Message Importance="high" Text="*** Building with TC_ROOT_DIR: $(TC_ROOT_DIR) (Version: $(TC_VERSION)) ***" />
  </Target>

  <!-- EXPORT MACROS TO VS INTERFACE -->
  <ItemGroup>
    <BuildMacro Include="CLIENT_PREFIX"><Value>$(CLIENT_PREFIX)</Value></BuildMacro>
    <BuildMacro Include="TC_VERSION"><Value>$(TC_VERSION)</Value></BuildMacro>
	<BuildMacro Include="TC_ROOT_DIR"><Value>$(TC_ROOT_DIR)</Value></BuildMacro>
  </ItemGroup>
</Project>
